# Porta e host do servidor Node.
# Na Hostinger a plataforma injeta PORT — não fixe o valor lá.
PORT=3000
HOST=0.0.0.0

# Banco MySQL (hPanel > Bancos de dados MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=SEU_BANCO
DB_USER=SEU_USUARIO
DB_PASSWORD=SUA_SENHA

# Pasta dos arquivos enviados (fora da pasta pública)
UPLOADS_DIR=./uploads

# Primeiro acesso: cria este usuário na inicialização SE a tabela `users`
# estiver vazia. Depois que existir qualquer usuário, estas variáveis são
# ignoradas (não trocam senha nem recriam a conta).
# Use um e-mail: o formulário de login do app usa <input type="email">.
ADMIN_USERNAME=admin@rgmtech.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador

# Deixe true para criar as contas da equipe pela tela de cadastro.
# Com usuários já cadastrados, o cadastro passa a exigir sessão autenticada.
ALLOW_SIGNUP=true
# Opcional: restringe o cadastro a um domínio de e-mail
SIGNUP_EMAIL_DOMAIN=

# Sessão (cookie httpOnly). Secure liga sozinho quando NODE_ENV=production.
SESSION_COOKIE=rgm_session
SESSION_DAYS=30
# SESSION_COOKIE_SECURE=true
