# Porta e host do servidor Node
PORT=3000
HOST=0.0.0.0

# Banco MySQL (hPanel > Bancos de dados MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=SEU_BANCO
DB_USER=SEU_USUARIO
DB_PASSWORD=SUA_SENHA

# Pasta dos arquivos enviados (fora da pasta pública)
UPLOADS_DIR=./uploads

# Deixe true para criar as contas da equipe e depois troque para false
ALLOW_SIGNUP=true
# Opcional: restringe o cadastro a um domínio de e-mail
SIGNUP_EMAIL_DOMAIN=
